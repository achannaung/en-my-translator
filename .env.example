# ---------------------------------------------------------------------------
# English <-> Burmese Translator - configuration
# Copy this file to `.env` and fill in the provider key(s) you want to use.
# Keys live ONLY on this machine; they are never sent to the browser.
# ---------------------------------------------------------------------------

# --- Provider API keys (at least one) -------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# --- Which provider/model to preselect (all optional) ---------------------
DEFAULT_PROVIDER=gemini

OPENAI_MODEL=gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_MODEL=gemini-flash-latest

# Temperature for translation (lower = more literal/consistent)
TEMPERATURE=0.2

# --- OpenAI-compatible base URL (change for Azure/proxy/local gateways) ----
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- OpenRouter attribution headers (optional, shown on their dashboard) ---
OPENROUTER_SITE_URL=http://127.0.0.1:5059
OPENROUTER_APP_NAME=EN-MY Translator

# --- Server ---------------------------------------------------------------
PORT=5059
